---
/** Diagramas de optimalidad dinámica: vista geométrica, rectángulos independientes, prueba p–q, Wilber 1 y 2, hijos preferidos y árbol de árboles. */
type Fig = 'satisfecho' | 'independientes' | 'pq' | 'wilber1' | 'wilber2' | 'preferidos' | 'arboles';
interface Props {
	fig: Fig;
}
const { fig } = Astro.props;
const A = `url(#oa-${fig})`;
const defs = `<defs><marker id="oa-${fig}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="head"/></marker></defs>`;

/* vista geométrica: llaves 1..4 en x, tiempo 1..4 hacia arriba */
const gx = (k: number) => 80 + k * 90;
const gy = (t: number) => 250 - t * 50;

/* árbol perfecto 0..6 */
const pos7: Record<number, { x: number; y: number }> = { 3: { x: 380, y: 40 }, 1: { x: 220, y: 110 }, 5: { x: 540, y: 110 }, 0: { x: 140, y: 180 }, 2: { x: 300, y: 180 }, 4: { x: 460, y: 180 }, 6: { x: 620, y: 180 } };
const aristas7 = [[3, 1], [3, 5], [1, 0], [1, 2], [5, 4], [5, 6]];
const seq = [0, 4, 2, 6, 1, 5];

/* árbol de referencia con hijos preferidos */
const P = { r: { x: 380, y: 40 }, a: { x: 230, y: 115 }, b: { x: 530, y: 115 }, c: { x: 160, y: 195 }, d: { x: 300, y: 195 }, e: { x: 460, y: 195 }, f: { x: 600, y: 195 } } as const;
const ejes: [keyof typeof P, keyof typeof P, boolean][] = [['r', 'a', true], ['r', 'b', false], ['a', 'c', false], ['a', 'd', true], ['b', 'e', true], ['b', 'f', false]];
---

<figure class="svgfig not-content">
	<div class="svgfig__scroll">
		{fig === 'satisfecho' && (
			<svg viewBox="0 0 760 290" role="img" aria-label="Vista geométrica: accesos como puntos (llave, tiempo); un rectángulo entre dos puntos sin otro punto adentro no está arboralmente satisfecho">
				<Fragment set:html={defs} />
				<line x1="120" y1="260" x2="480" y2="260" class="axis" marker-end={A} />
				<line x1="120" y1="260" x2="120" y2="20" class="axis" marker-end={A} />
				<text x="490" y="276" class="t s l mu">llave</text>
				<text x="110" y="20" class="t s r mu">tiempo</text>
				{[1, 2, 3, 4].map((k) => <text x={gx(k)} y="280" class="t s mono">{k}</text>)}
				{[1, 2, 3, 4].map((t) => <text x="100" y={gy(t) + 5} class="t s r mono">{t}</text>)}
				<rect x={gx(1)} y={gy(3)} width={gx(3) - gx(1)} height={gy(1) - gy(3)} class="trap" />
				{[[3, 1], [1, 3]].map(([k, t]) => <circle cx={gx(k)} cy={gy(t)} r="9" class="c5" />)}
				{[[2, 2], [4, 4]].map(([k, t]) => <circle cx={gx(k)} cy={gy(t)} r="9" class="c1" />)}
				<rect x={gx(2) + 330} y={gy(4)} width={0} height={0} class="frame" />
				<text x="620" y="70" class="t s">accesos: 3, 2, 1, 4</text>
				<text x="620" y="96" class="t s">(llave en x, tiempo en y)</text>
				<text x="620" y="140" class="t s bad">rectángulo (3,1)–(1,3):</text>
				<text x="620" y="160" class="t s bad">¿tiene otro punto?</text>
				<text x="620" y="190" class="t s">sí: (2, 2) está dentro →</text>
				<text x="620" y="210" class="t s">está satisfecho ✔</text>
			</svg>
		)}

		{fig === 'independientes' && (
			<svg viewBox="0 0 760 210" role="img" aria-label="Tres pares de rectángulos: separados (independientes), parcialmente contenidos sin esquina adentro (independientes) y con una esquina adentro (no independientes)">
				<Fragment set:html={defs} />
				<rect x="30" y="40" width="80" height="60" class="c1" />
				<rect x="130" y="90" width="80" height="70" class="c3" />
				<text x="125" y="190" class="t s ok">separados: independientes</text>
				<rect x="280" y="40" width="200" height="50" class="c1" />
				<rect x="330" y="20" width="60" height="140" class="c3" />
				<text x="380" y="190" class="t s ok">se cruzan sin esquina adentro: independientes</text>
				<rect x="560" y="40" width="110" height="80" class="c1" />
				<rect x="620" y="90" width="110" height="80" class="c3" />
				<circle cx="620" cy="90" r="6" class="trap" />
				<text x="645" y="190" class="t s bad">esquina dentro del otro: NO</text>
			</svg>
		)}

		{fig === 'pq' && (
			<svg viewBox="0 0 760 220" role="img" aria-label="Prueba: segmento vertical que cruza el rectángulo más ancho; p a la izquierda y q a la derecha en la misma fila; el segmento pq lo cruza">
				<Fragment set:html={defs} />
				<rect x="140" y="40" width="480" height="140" class="c1" />
				<text x="380" y="34" class="t s mu">el rectángulo más ancho de S (positivo)</text>
				<line x1="380" y1="30" x2="380" y2="196" class="ln bad" />
				<text x="392" y="212" class="t s l bad">segmento vertical del paso 1</text>
				<circle cx="300" cy="110" r="9" class="c2" />
				<text x="300" y="96" class="t s b">p</text>
				<circle cx="470" cy="110" r="9" class="c2" />
				<text x="470" y="96" class="t s b">q</text>
				<line x1="309" y1="110" x2="461" y2="110" class="ln ok" />
				<text x="120" y="110" class="t s r">p: el de OPT⁺ más a la</text>
				<text x="120" y="128" class="t s r">derecha y arriba, a la izquierda</text>
				<text x="640" y="110" class="t s l">q: el más a la izquierda</text>
				<text x="640" y="128" class="t s l">y abajo, a la derecha</text>
			</svg>
		)}

		{fig === 'wilber1' && (
			<svg viewBox="0 0 760 300" role="img" aria-label="Wilber 1 sobre el BST perfecto 0 a 6 con la secuencia 0 4 2 6 1 5: en la raíz alterna izquierda-derecha 5 veces">
				<Fragment set:html={defs} />
				{aristas7.map(([a, b]) => <line x1={pos7[a].x} y1={pos7[a].y} x2={pos7[b].x} y2={pos7[b].y} class="ln" />)}
				{Object.entries(pos7).map(([k, p]) => (
					<>
						<circle cx={p.x} cy={p.y} r="20" class={k === '3' ? 'c5' : 'box'} />
						<text x={p.x} y={p.y + 5} class="t b mono">{k}</text>
					</>
				))}
				<text x="40" y="236" class="t s l b">accesos</text>
				<text x="40" y="266" class="t s l b">en la raíz</text>
				{seq.map((x, i) => (
					<>
						<rect x={170 + i * 80} y="216" width="60" height="30" rx="5" class={x < 3 ? 'c1' : 'c3'} />
						<text x={200 + i * 80} y="236" class="t s b mono">{x}</text>
						<text x={200 + i * 80} y="268" class="t s">{x < 3 ? 'izq' : 'der'}</text>
						{i > 0 && <text x={160 + i * 80} y="268" class="t s bad">↔</text>}
					</>
				))}
				<text x="380" y="292" class="t s mu">raíz: 5 alternancias · nodo 1 (ve 0, 2, 1): 1 · nodo 5 (ve 4, 6, 5): 1 → Wilber-1 = 7 (ejemplo propio)</text>
			</svg>
		)}

		{fig === 'wilber2' && (
			<svg viewBox="0 0 760 260" role="img" aria-label="Wilber 2: desde el punto p se miran hacia abajo los puntos visibles y se cuentan los cambios de lado">
				<Fragment set:html={defs} />
				<line x1="100" y1="240" x2="660" y2="240" class="axis" marker-end={A} />
				<line x1="100" y1="240" x2="100" y2="20" class="axis" marker-end={A} />
				<text x="670" y="256" class="t s l mu">llave</text>
				<text x="90" y="20" class="t s r mu">tiempo</text>
				<circle cx="380" cy="40" r="10" class="c2" />
				<text x="380" y="26" class="t s b">p</text>
				{[[330, 80, 'izq'], [440, 115, 'der'], [300, 150, 'izq'], [500, 185, 'der'], [240, 220, 'izq']].map(([x, y, s]) => (
					<>
						<line x1="380" y1="40" x2={x} y2={y} class="ln dash" />
						<circle cx={x} cy={y} r="8" class={s === 'izq' ? 'c1' : 'c3'} />
						<text x={Number(x) + (s === 'izq' ? -16 : 16)} y={Number(y) + 4} class={`t s ${s === 'izq' ? 'r' : 'l'}`}>{s}</text>
					</>
				))}
				<text x="560" y="70" class="t s l">visibles desde p, de arriba</text>
				<text x="560" y="90" class="t s l">hacia abajo: izq, der, izq,</text>
				<text x="560" y="110" class="t s l">der, izq → 4 alternancias</text>
				<text x="380" y="256" class="t s mu">esquema ilustrativo: un punto es visible si su rectángulo con p no contiene otro punto</text>
			</svg>
		)}

		{fig === 'preferidos' && (
			<svg viewBox="0 0 760 250" role="img" aria-label="Árbol de referencia con hijos preferidos: caminos r-a-d, b-e, c y f">
				<Fragment set:html={defs} />
				{ejes.map(([u, v, pref]) => <line x1={P[u].x} y1={P[u].y} x2={P[v].x} y2={P[v].y} class={pref ? 'ln ok' : 'ln dash'} style={pref ? 'stroke-width:5' : ''} />)}
				{Object.entries(P).map(([k, p]) => (
					<>
						<circle cx={p.x} cy={p.y} r="20" class={['r', 'a', 'd'].includes(k) ? 'c4' : ['b', 'e'].includes(k) ? 'c1' : 'c3'} />
						<text x={p.x} y={p.y + 5} class="t b">{k}</text>
					</>
				))}
				<text x="380" y="240" class="t s">verde grueso = hijo preferido · caminos: {'{r, a, d}'}, {'{b, e}'}, {'{c}'}, {'{f}'}</text>
			</svg>
		)}

		{fig === 'arboles' && (
			<svg viewBox="0 0 760 250" role="img" aria-label="Árbol de árboles: cada camino preferido es un árbol auxiliar de altura O(lg lg n); sus hojas enlazan a los árboles de los caminos hijos">
				<Fragment set:html={defs} />
				<polygon points="380,20 290,100 470,100" class="c4" />
				<text x="380" y="78" class="t s b">camino raíz</text>
				<polygon points="200,130 140,200 260,200" class="c1" />
				<text x="200" y="185" class="t s b">A</text>
				<polygon points="560,130 500,200 620,200" class="c1" />
				<text x="560" y="185" class="t s b">B</text>
				<polygon points="620,215 590,248 650,248" class="c3" />
				<text x="620" y="244" class="t s b">C</text>
				<line x1="310" y1="100" x2="210" y2="130" class="ln" marker-end={A} />
				<line x1="450" y1="100" x2="550" y2="130" class="ln" marker-end={A} />
				<line x1="600" y1="200" x2="616" y2="214" class="ln" marker-end={A} />
				<line x1="720" y1="20" x2="720" y2="100" class="ln" />
				<text x="712" y="64" class="t s r">O(lg lg n)</text>
				<text x="40" y="236" class="t s l mu">cada triángulo = un árbol auxiliar (BBST) de un camino preferido, con O(lg n) nodos</text>
			</svg>
		)}
	</div>
	<figcaption><slot /></figcaption>
</figure>
