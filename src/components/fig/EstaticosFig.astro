---
/** Diagramas de árboles estáticos: Sparse Table, consulta con solape, cartesian tree, Euler tour, bloques y la cadena de reducciones. */
type Fig = 'consulta' | 'cartesiano' | 'euler' | 'bloques' | 'cadena';
interface Props {
	fig: Fig;
}
const { fig } = Astro.props;
const A = `url(#sa-${fig})`;
const defs = `<defs><marker id="sa-${fig}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="head"/></marker></defs>`;

const arr = [5, 3, 8, 1, 9, 4, 7, 2];
const cx = (i: number) => 120 + i * 66;

/* cartesian tree de [5,3,8,1,9,4,7,2]: padre de cada posición */
const padre: Record<number, number> = { 1: 3, 7: 3, 0: 1, 2: 1, 5: 7, 4: 5, 6: 5 };
const prof: Record<number, number> = { 3: 0, 1: 1, 7: 1, 0: 2, 2: 2, 5: 2, 4: 3, 6: 3 };
const nodo = (i: number) => ({ x: 70 + i * 88, y: 40 + prof[i] * 62 });

/* árbol A(B(D,E),C) */
const T = { A: { x: 380, y: 40 }, B: { x: 240, y: 110 }, C: { x: 520, y: 110 }, D: { x: 160, y: 180 }, E: { x: 320, y: 180 } } as const;
const tour = ['A', 'B', 'D', 'B', 'E', 'B', 'A', 'C', 'A'] as const;
const dep = { A: 0, B: 1, C: 1, D: 2, E: 2 } as const;
---

<figure class="svgfig not-content">
	<div class="svgfig__scroll">
		{fig === 'consulta' && (
			<svg viewBox="0 0 760 230" role="img" aria-label="Consulta RMQ de 1 a 6 con dos intervalos de longitud 4 que se solapan: de 1 a 4 y de 3 a 6">
				<Fragment set:html={defs} />
				{arr.map((v, i) => (
					<>
						<rect x={cx(i) - 28} y="110" width="56" height="44" rx="6" class={i === 3 ? 'c4' : i >= 1 && i <= 6 ? 'box' : 'cell-off'} />
						<text x={cx(i)} y="138" class="t b mono">{v}</text>
						<text x={cx(i)} y="174" class="t s mu mono">{i}</text>
					</>
				))}
				<rect x={cx(1) - 28} y="62" width={cx(4) - cx(1) + 56} height="30" rx="8" class="c1" />
				<text x={(cx(1) + cx(4)) / 2} y="82" class="t s">M[2][1] → [1, 4]: mínimo en 3</text>
				<rect x={cx(3) - 28} y="22" width={cx(6) - cx(3) + 56} height="30" rx="8" class="c3" />
				<text x={(cx(3) + cx(6)) / 2} y="42" class="t s">M[2][3] → [3, 6]: mínimo en 3</text>
				<text x="380" y="206" class="t s">consulta [1, 6]: longitud 6, k = ⌊lg 6⌋ = 2 → dos bloques de 4 que se solapan en [3, 4]</text>
				<text x="380" y="224" class="t s mu">el solape no molesta: min(x, x) = x (operación idempotente)</text>
			</svg>
		)}

		{fig === 'cartesiano' && (
			<svg viewBox="0 0 760 300" role="img" aria-label="Cartesian tree del arreglo 5 3 8 1 9 4 7 2: raíz posición 3 (valor 1)">
				<Fragment set:html={defs} />
				{Object.entries(padre).map(([h, p]) => {
					const a = nodo(Number(p));
					const b = nodo(Number(h));
					return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class="ln" />;
				})}
				{arr.map((v, i) => (
					<>
						<circle cx={nodo(i).x} cy={nodo(i).y} r="20" class={i === 3 ? 'c4' : i === 5 ? 'c2' : 'box'} />
						<text x={nodo(i).x} y={nodo(i).y + 5} class="t b mono">{v}</text>
						<text x={nodo(i).x} y={nodo(i).y + 36} class="t s mu mono">pos {i}</text>
					</>
				))}
				<text x="380" y="286" class="t s">inorden = 0, 1, …, 7 (posiciones) · padre &lt; hijos (heap) · LCA(4, 6) = pos 5 = RMQ(4, 6)</text>
			</svg>
		)}

		{fig === 'euler' && (
			<svg viewBox="0 0 760 330" role="img" aria-label="Euler tour del árbol A con hijos B y C, B con hijos D y E: A B D B E B A C A con profundidades 0 1 2 1 2 1 0 1 0">
				<Fragment set:html={defs} />
				<line x1={T.A.x} y1={T.A.y} x2={T.B.x} y2={T.B.y} class="ln" />
				<line x1={T.A.x} y1={T.A.y} x2={T.C.x} y2={T.C.y} class="ln" />
				<line x1={T.B.x} y1={T.B.y} x2={T.D.x} y2={T.D.y} class="ln" />
				<line x1={T.B.x} y1={T.B.y} x2={T.E.x} y2={T.E.y} class="ln" />
				{Object.entries(T).map(([k, p]) => (
					<>
						<circle cx={p.x} cy={p.y} r="20" class="c1" />
						<text x={p.x} y={p.y + 5} class="t b">{k}</text>
					</>
				))}
				{tour.map((v, t) => (
					<>
						<rect x={92 + t * 64} y="250" width="56" height="30" rx="5" class={t === 2 || t === 4 ? 'c2' : t === 3 ? 'c4' : 'box'} />
						<text x={120 + t * 64} y="270" class="t s b">{v}</text>
						<text x={120 + t * 64} y="300" class="t s mono">{dep[v]}</text>
					</>
				))}
				<text x="60" y="270" class="t s r mu">E</text>
				<text x="60" y="300" class="t s r mu">D</text>
				<text x="380" y="324" class="t s mu">LCA(D, E): entre la 1.ª aparición de D (t = 2) y la de E (t = 4), la menor profundidad está en t = 3 → B</text>
			</svg>
		)}

		{fig === 'bloques' && (
			<svg viewBox="0 0 760 240" role="img" aria-label="Arreglo partido en bloques de tamaño b; consulta de i a j = sufijo del bloque de i + bloques completos (Sparse Table) + prefijo del bloque de j">
				<Fragment set:html={defs} />
				{Array.from({ length: 4 }, (_, b) => (
					<>
						<rect x={60 + b * 165} y="80" width="155" height="44" rx="6" class="box" />
						{Array.from({ length: 4 }, (_, c) => <line x1={60 + b * 165 + (c + 1) * 38.75} y1="80" x2={60 + b * 165 + (c + 1) * 38.75} y2="124" class="sep" />)}
						<text x={137 + b * 165} y="150" class="t s mu">bloque {b}</text>
					</>
				))}
				<rect x={60 + 2 * 38.75} y="72" width={2 * 38.75 + 4} height="60" rx="6" class="c2" />
				<rect x={60 + 165} y="72" width="320" height="60" rx="6" class="hl" />
				<rect x={60 + 3 * 165} y="72" width={38.75 * 2} height="60" rx="6" class="c3" />
				<text x="117" y="56" class="t s">micro: sufijo</text>
				<text x="385" y="56" class="t s">macro: Sparse Table sobre mínimos de bloque</text>
				<text x="595" y="56" class="t s">micro: prefijo</text>
				<line x1={60 + 2 * 38.75} y1="190" x2={60 + 2 * 38.75} y2="140" class="ln" marker-end={A} />
				<text x={60 + 2 * 38.75} y="208" class="t s b">i</text>
				<line x1={60 + 3 * 165 + 77.5} y1="190" x2={60 + 3 * 165 + 77.5} y2="140" class="ln" marker-end={A} />
				<text x={60 + 3 * 165 + 77.5} y="208" class="t s b">j</text>
				<text x="380" y="232" class="t s mu">a lo más 2 consultas micro + 1 macro; si i y j caen en el mismo bloque, solo una micro</text>
			</svg>
		)}

		{fig === 'cadena' && (
			<svg viewBox="0 0 760 150" role="img" aria-label="Cadena de reducciones: RMQ general → cartesian tree → LCA → Euler tour → ±1 RMQ, todas en O(n)">
				<Fragment set:html={defs} />
				{[['RMQ general', 'arreglo A', 'c2'], ['LCA', 'cartesian tree', 'c1'], ['±1 RMQ', 'Euler tour (profundidades)', 'c4']].map(([t, s, c], k) => (
					<>
						<rect x={40 + k * 260} y="40" width="200" height="64" rx="10" class={c} />
						<text x={140 + k * 260} y="68" class="t b">{t}</text>
						<text x={140 + k * 260} y="90" class="t s mu">{s}</text>
						{k < 2 && <line x1={242 + k * 260} y1="72" x2={298 + k * 260} y2="72" class="ln" marker-end={A} />}
						{k < 2 && <text x={270 + k * 260} y="60" class="t s">O(n)</text>}
					</>
				))}
				<text x="380" y="134" class="t s">RMQ_A(i, j) = LCA_T(i, j) = E[ RMQ±1(first[i], first[j]) ]</text>
			</svg>
		)}
	</div>
	<figcaption><slot /></figcaption>
</figure>
